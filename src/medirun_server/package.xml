<?xml version="1.0"?>
<package format="3">
  <name>medirun_server</name>
  <version>0.1.0</version>
  <description>MediRun 중앙 서버(PC, 헤드리스 ROS 2 노드): 호출 대기열·출동·도착 통지·로봇 상태 집계·운용 기록을 로봇과 ROS 2 토픽/액션/서비스로 처리한다.</description>
  <maintainer email="team@example.com">aurix</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- 선택: 없으면 PostgreSQL 기록만 꺼지고 JSONL 기록은 계속된다 -->
  <exec_depend>python3-psycopg2</exec_depend>
  <!-- server_bringup.launch.py 가 콜존 파이프라인(mqtt_bridge, emergency_dispatcher)을 같이 띄운다 -->
  <exec_depend>medirun_sensor</exec_depend>
  <exec_depend>medirun_mission</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
